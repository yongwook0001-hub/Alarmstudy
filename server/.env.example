GEMINI_API_KEY=your_gemini_api_key_here
# 선택: 기본값은 gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite

# Postgres 접속 정보 — docker-compose가 db 컨테이너 생성 + DATABASE_URL 조립에 이 값들을 그대로 씀
POSTGRES_DB=alarmstudy_db
POSTGRES_USER=alarmstudy
POSTGRES_PASSWORD=alarmstudy_pw

# docker-compose 없이 uvicorn/alembic을 로컬에서 직접 돌릴 때만 필요.
# 설정하면 이 값이 위 POSTGRES_* 조합보다 우선한다 (app/core/config.py 참고).
# DATABASE_URL=postgresql+asyncpg://alarmstudy:alarmstudy_pw@localhost:5432/alarmstudy_db

# 구글 로그인 — Google Cloud Console에서 만든 "웹 클라이언트" ID
# (안드로이드 클라이언트 ID가 아니라 웹 클라이언트 ID! google_sign_in의 serverClientId와 값이 같아야 함)
GOOGLE_OAUTH_CLIENT_ID=your_google_web_client_id_here

# 자체 발급 JWT 서명 키 — 반드시 운영 환경에서는 긴 랜덤 문자열로 교체할 것
# 생성 예: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# 참고: 카카오는 사용자의 access_token만으로 검증하는 구조라 서버에 별도 키가 필요 없음
# (app/services/oauth.py의 KakaoOAuthVerifier 참고)

# 참고: access/refresh token 만료 시간은 app/core/constants.py에 상수로 고정돼 있음
# (환경변수로 설정하는 값이 아님 — 바꾸려면 그 파일을 직접 수정)

# ── 학습자료 → 알람 노래 생성 (Vertex AI Lyria 3) ────────────────────
# Gemini API 키(GEMINI_API_KEY)와는 별개로, Vertex AI는 결제(빌링)가 연결된
# GCP 프로젝트 + 인증이 필요함.
GCP_PROJECT_ID=your_gcp_project_id_here

# 인증 방법 A (조직 정책으로 서비스 계정 키 발급이 막혀있으면 이 방법 사용):
# 터미널에서 아래 명령 한 번 실행 → GOOGLE_APPLICATION_CREDENTIALS는 비워둬도 자동 인식됨
#   gcloud auth application-default login --scopes=https://www.googleapis.com/auth/cloud-platform
#
# 인증 방법 B (서비스 계정 키 발급이 가능한 경우):
# IAM 및 관리자 → 서비스 계정 → 새로 만들기 → 역할 "Vertex AI(Agent Platform) 사용자" 부여
# → 키 → 새 키 만들기(JSON) → 다운로드한 파일의 절대경로를 아래에 지정
# (이 JSON 파일은 절대 git에 올리면 안 됨 — .env처럼 로컬에만 둘 것)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-service-account-key.json

# 선택: lyria-3-pro-preview(최대 3분, 고품질) 또는 lyria-3-clip-preview(짧고 빠름)
LYRIA_MODEL=lyria-3-pro-preview
