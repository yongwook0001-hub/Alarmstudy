GEMINI_API_KEY=your_gemini_api_key_here
# 선택: 기본값은 gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite

# docker-compose 없이 uvicorn을 로컬에서 직접 띄울 때만 필요
# (docker-compose로 띄우면 POSTGRES_* 값으로부터 자동 조합되어 주입됨)
DATABASE_URL=postgresql+asyncpg://alarmstudy:alarmstudy_pw@localhost:5432/alarmstudy_db

# 구글 로그인 — Google Cloud Console에서 만든 "웹 클라이언트" ID
# (안드로이드 클라이언트 ID가 아니라 웹 클라이언트 ID! google_sign_in의 serverClientId와 값이 같아야 함)
GOOGLE_CLIENT_ID=your_google_web_client_id_here

# 카카오 로그인 — 지금 구현된 로그인 로직 자체엔 안 쓰이지만(사용자 access_token으로 검증),
# 나중에 카카오톡 메시지 전송 등 다른 카카오 API를 쓰게 되면 필요해서 미리 자리만 마련해둠
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 자체 발급 JWT 서명 키 — 반드시 운영 환경에서는 긴 랜덤 문자열로 교체할 것
# 생성 예: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
# 선택: access token 만료(분), refresh token 만료(일). 기본값은 각각 30분/30일
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
