import 'package:flutter/material.dart';
import '../theme/app_theme.dart';
import '../widgets/section_title.dart';
import '../widgets/settings_group.dart';

/// 알림 설정 화면.
///
/// TODO(실서버 연동): 지금은 토글 값을 화면 메모리에만 들고 있는 목업 상태.
/// 나중에 서버에 알림 설정 저장 API가 생기면, 여기 값들을 그 API로 불러오고/저장하도록
/// 바꾸면 됨 — UI 구조(스위치 목록)는 그대로 두고 데이터 소스만 교체하면 되도록
/// 상태를 이 화면 하나에 모아둠.
class NotificationSettingsScreen extends StatefulWidget {
  const NotificationSettingsScreen({super.key});

  @override
  State<NotificationSettingsScreen> createState() => _NotificationSettingsScreenState();
}

class _NotificationSettingsScreenState extends State<NotificationSettingsScreen> {
  bool _alarmReminder = true;
  bool _quizResult = true;
  bool _streakWarning = true;
  bool _weeklyReport = false;
  bool _marketing = false;

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: kBg,
      appBar: AppBar(
        backgroundColor: kBg,
        elevation: 0,
        title: Text('알림 설정', style: TextStyle(color: kFg)),
        iconTheme: IconThemeData(color: kFg),
        leading: IconButton(
          icon: const Icon(Icons.arrow_back_ios),
          onPressed: () => Navigator.pop(context),
        ),
      ),
      body: SafeArea(
        child: ListView(
          padding: const EdgeInsets.all(20),
          children: [
            const SectionTitle('알람'),
            const SizedBox(height: 8),
            SettingsGroup(items: [
              _switchRow(
                '알람 리마인더',
                '알람 울리기 10분 전에 미리 알려줘요',
                _alarmReminder,
                (v) => setState(() => _alarmReminder = v),
              ),
              _switchRow(
                '퀴즈 결과 알림',
                '퀴즈를 풀고 나면 정답/오답 결과를 알려줘요',
                _quizResult,
                (v) => setState(() => _quizResult = v),
              ),
              _switchRow(
                '스트릭 끊김 경고',
                '기상 스트릭이 끊기기 전에 미리 알려줘요',
                _streakWarning,
                (v) => setState(() => _streakWarning = v),
              ),
            ]),
            const SizedBox(height: 20),
            const SectionTitle('기타'),
            const SizedBox(height: 8),
            SettingsGroup(items: [
              _switchRow(
                '주간 리포트',
                '한 주 학습 통계를 요약해서 보내줘요',
                _weeklyReport,
                (v) => setState(() => _weeklyReport = v),
              ),
              _switchRow(
                '이벤트/마케팅 알림',
                '신규 기능, 이벤트 소식을 받아요',
                _marketing,
                (v) => setState(() => _marketing = v),
              ),
            ]),
          ],
        ),
      ),
    );
  }

  Widget _switchRow(String title, String subtitle, bool value, ValueChanged<bool> onChanged) {
    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
      child: Row(
        children: [
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(title, style: TextStyle(color: kFg, fontSize: 15, fontWeight: FontWeight.w600)),
                const SizedBox(height: 2),
                Text(subtitle, style: TextStyle(color: kMuted, fontSize: 12)),
              ],
            ),
          ),
          Switch(value: value, activeColor: kPrimary, onChanged: onChanged),
        ],
      ),
    );
  }
}
