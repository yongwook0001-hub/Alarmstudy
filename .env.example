# Flutter 앱(클라이언트)용 환경변수. 실제 값은 이 파일(.env.example)이 아니라
# 로컬 .env에만 넣을 것 — .env는 .gitignore에 걸려 있어서 커밋되지 않음.

# 백엔드(FastAPI) 서버 주소. 안드로이드 에뮬레이터에서 로컬 PC 접속 시 10.0.2.2 사용.
API_BASE_URL=http://10.0.2.2:8000

# 카카오 로그인 SDK 초기화용 (Kakao Developers > 앱 키 > 네이티브 앱 키)
KAKAO_NATIVE_APP_KEY=your_kakao_native_app_key_here
